# ====================================================================
# Sylpheed OAuth 2.0 Configuration Sample
#
# Copy this file to:
#   Windows: %APPDATA%\Sylpheed\oauth2.ini
#   Linux/Unix: ~/.sylpheed-2.0/oauth2.ini
#
# See OAUTH2.md for full setup instructions.
# ====================================================================

# --------------------------------------------------------------------
# Google (Gmail)
# Obtain client_id & client_secret from Google Cloud Console
# (Application Type: Desktop App)
# --------------------------------------------------------------------
[*@gmail.com]
auth_uri=https://accounts.google.com/o/oauth2/auth
token_uri=https://oauth2.googleapis.com/token
redirect_uri=http://localhost:8089/
client_id=<enter client id here>
client_secret=<enter client secret here>
scope=https://mail.google.com/
local_port=8089

# --------------------------------------------------------------------
# Microsoft 365 (Organization / Azure AD)
# Obtain client_id & client_secret from Microsoft Entra ID (Azure Portal)
# --------------------------------------------------------------------
[*@*.onmicrosoft.com]
auth_uri=https://login.microsoftonline.com/common/oauth2/v2.0/authorize
token_uri=https://login.microsoftonline.com/common/oauth2/v2.0/token
redirect_uri=http://localhost:8089/
client_id=<enter client id here>
client_secret=<enter client secret here>
scope=offline_access https://outlook.office.com/POP.AccessAsUser.All https://outlook.office.com/IMAP.AccessAsUser.All https://outlook.office.com/SMTP.Send
local_port=8089

# --------------------------------------------------------------------
# Microsoft Outlook.com / Hotmail (Personal Accounts)
# --------------------------------------------------------------------
[*@outlook.com]
auth_uri=https://login.microsoftonline.com/common/oauth2/v2.0/authorize
token_uri=https://login.microsoftonline.com/common/oauth2/v2.0/token
redirect_uri=http://localhost:8089/
client_id=<enter client id here>
client_secret=<enter client secret here>
scope=offline_access https://outlook.office.com/POP.AccessAsUser.All https://outlook.office.com/IMAP.AccessAsUser.All https://outlook.office.com/SMTP.Send
local_port=8089

[*@hotmail.com]
auth_uri=https://login.microsoftonline.com/common/oauth2/v2.0/authorize
token_uri=https://login.microsoftonline.com/common/oauth2/v2.0/token
redirect_uri=http://localhost:8089/
client_id=<enter client id here>
client_secret=<enter client secret here>
scope=offline_access https://outlook.office.com/POP.AccessAsUser.All https://outlook.office.com/IMAP.AccessAsUser.All https://outlook.office.com/SMTP.Send
local_port=8089
